# SMTP Server Configurations
# You can add more servers by incrementing the number (e.g., SMTP_HOST_3, SMTP_USER_3, etc.)
SMTP_HOST_1=smtp1.example.com
SMTP_PORT_1=587
SMTP_SECURE_1=false
SMTP_USER_1=user1@example.com
SMTP_PASS_1=password1

SMTP_HOST_2=smtp2.example.com
SMTP_PORT_2=587
SMTP_SECURE_2=false
SMTP_USER_2=user2@example.com
SMTP_PASS_2=password2

# --- Email Cloning Options ---
# Set to "true" to send the email from the CEO's actual email address.
# Set to "false" to only use the CEO's name in the "From" header.
CLONE_CEO_EMAIL=true
