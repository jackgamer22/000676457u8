# --- Mail Provider ---
# Choose your email provider: "smtp" or "sendgrid"
MAIL_PROVIDER=smtp

# --- API Keys ---
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE
SENDGRID_FROM_EMAIL=YOUR_VERIFIED_SENDGRID_EMAIL_HERE

# --- SMTP Server Configurations (only used if MAIL_PROVIDER is "smtp") ---
SMTP_HOST_1=smtp1.example.com
SMTP_PORT_1=587
SMTP_SECURE_1=false
SMTP_USER_1=user1@example.com
SMTP_PASS_1=password1

SMTP_HOST_2=smtp2.example.com
SMTP_PORT_2=587
SMTP_SECURE_2=false
SMTP_USER_2=user2@example.com
SMTP_PASS_2=password2

# --- Email Content ---
NAME_MAGXXIC="Name Magxxic"

# --- Sending Options ---
# Set to "true" to send the email from the CEO's actual email address.
# Set to "false" to only use the CEO's name in the "From" header.
CLONE_CEO_EMAIL=true
